{
    "name": "duj/wellness",
    "description": "Rezervační systém wellness pro WordPress — Domeček u Josefa",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1",
        "stripe/stripe-php": "^13.0",
        "endroid/qr-code": "^5.0",
        "woocommerce/action-scheduler": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Duj\\Wellness\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Duj\\Wellness\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
